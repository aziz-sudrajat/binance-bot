# Copy to .env and fill in

# paper | testnet | live
TRADE_MODE=testnet

# Binance Futures API (testnet keys from https://testnet.binancefuture.com)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Required only for TRADE_MODE=live
LIVE_CONFIRM=

# Risk
RISK_PCT=1.0
MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=3
MIN_QUALITY=62
MARGIN_MODE=ISOLATED
MIN_NOTIONAL_USDT=5
DAILY_LOSS_CAP_PCT=10
ORDER_TTL_SEC=1800

# Universe: "top" or comma list e.g. BTCUSDT,ETHUSDT,SOLUSDT
UNIVERSE=top
TOP_N=40
MIN_24H_VOLUME_USD=5000000

# BTC 15m must match signal direction (1/0)
BTC_ALIGN=1

SCAN_INTERVAL_SEC=900
